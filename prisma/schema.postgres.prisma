generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                String            @id @default(cuid())
  slug              String            @unique
  name              String
  phone             String            @default("")
  email             String            @default("")
  address           String            @default("")
  instagram          String            @default("")
  aiEnabled         Boolean           @default(true)
  aiInstructions    String            @default("")
  timezone          String            @default("America/Sao_Paulo")
  cancelNoticeHours Int               @default(4)
  createdAt         DateTime          @default(now())
  users             User[]
  customers         Customer[]
  barbers           Barber[]
  services          Service[]
  hairStyles        HairStyle[]
  appointments      Appointment[]
  workingHours      WorkingHour[]
  barberWorkingHours BarberWorkingHour[]
  blockedTimes      BlockedTime[]
  appointmentSlots AppointmentSlot[]
  payments          Payment[]
  gallery           Gallery[]
  aiConversations   AIConversation[]
  passwordResets    PasswordResetToken[]
}

model User {
  id              String           @id @default(cuid())
  tenantId        String
  email           String
  name            String
  phone            String?
  passwordHash    String
  role             String
  photoUrl        String?
  active           Boolean          @default(true)
  sessionVersion  Int              @default(0)
  createdAt       DateTime         @default(now())
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerProfile Customer?
  barberProfile   Barber?
  aiConversations AIConversation[]
  passwordResets  PasswordResetToken[]

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model Customer {
  id                String        @id @default(cuid())
  tenantId          String
  userId            String        @unique
  preferredBarberId String?
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredBarber   Barber?       @relation("PreferredBarber", fields: [preferredBarberId], references: [id], onDelete: SetNull)
  appointments      Appointment[]

  @@index([tenantId])
}

model Barber {
  id               String              @id @default(cuid())
  tenantId         String
  userId           String?             @unique
  name             String
  bio              String              @default("")
  specialties      String              @default("")
  rating           Float               @default(5)
  reviewCount      Int                 @default(0)
  active           Boolean             @default(true)
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  preferredBy      Customer[]          @relation("PreferredBarber")
  appointments     Appointment[]
  workingHours     BarberWorkingHour[]
  blockedTimes     BlockedTime[]
  appointmentSlots AppointmentSlot[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

model Service {
  id              String        @id @default(cuid())
  tenantId        String
  name            String
  description     String        @default("")
  priceCents      Int
  durationMinutes Int
  imageUrl        String?
  active          Boolean       @default(true)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hairStyles      HairStyle[]
  appointments    Appointment[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

model HairStyle {
  id           String        @id @default(cuid())
  tenantId     String
  serviceId    String?
  name         String
  description  String        @default("")
  imageUrl     String?
  active       Boolean       @default(true)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

model Appointment {
  id              String            @id @default(cuid())
  code            String            @unique
  tenantId        String
  customerId      String
  barberId        String
  serviceId       String
  hairStyleId     String?
  startsAt        DateTime
  durationMinutes Int
  priceCents      Int
  status          String            @default("PENDENTE")
  notes           String            @default("")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  barber          Barber            @relation(fields: [barberId], references: [id], onDelete: Restrict)
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  hairStyle       HairStyle?        @relation(fields: [hairStyleId], references: [id], onDelete: SetNull)
  slots           AppointmentSlot[]
  payment         Payment?

  @@index([tenantId, startsAt])
  @@index([tenantId, customerId, status])
  @@index([tenantId, barberId, startsAt])
}

model WorkingHour {
  id          String  @id @default(cuid())
  tenantId    String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  isOpen      Boolean @default(true)
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek, startMinute])
}

model BarberWorkingHour {
  id          String  @id @default(cuid())
  tenantId    String
  barberId    String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  isAvailable Boolean @default(true)
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barber      Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, dayOfWeek, startMinute])
  @@index([tenantId, dayOfWeek])
}

model BlockedTime {
  id       String   @id @default(cuid())
  tenantId String
  barberId String?
  startsAt DateTime
  endsAt   DateTime
  reason   String   @default("")
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barber   Barber?  @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt, endsAt])
  @@index([barberId, startsAt, endsAt])
}

model AppointmentSlot {
  id            String      @id @default(cuid())
  tenantId      String
  barberId      String
  appointmentId String
  startsAt      DateTime
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barber        Barber      @relation(fields: [barberId], references: [id], onDelete: Cascade)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([barberId, startsAt])
  @@index([appointmentId])
}

model Payment {
  id            String       @id @default(cuid())
  tenantId      String
  appointmentId String?      @unique
  amountCents   Int
  status        String       @default("PENDENTE")
  method        String       @default("")
  createdAt     DateTime     @default(now())
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
}

model Gallery {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  imageUrl  String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active, position])
}

model AIConversation {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  messages  String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, updatedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, expiresAt])
}
